# Server Configuration
PORT=5000
NODE_ENV=development

# Database
# Provide MongoDB Atlas URI (or leave empty to use built-in zero-config local storage)
MONGO_URI=mongodb://localhost:27017/carepal

# Authentication
JWT_SECRET=thecarepal-super-secret-jwt-key-change-in-production-fs03
JWT_EXPIRES_IN=7d
COOKIE_NAME=carepal_session

# Seed Passwords (used only during npm run seed)
NURSE_SEED_PASSWORD=NursePass123!
FAMILY_SEED_PASSWORD=FamilyPass123!

# Client Origin (CORS)
CLIENT_URL=http://localhost:5173

# Email Alerts (Optional SMTP / Resend)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_FROM=alerts@thecarepal.com
